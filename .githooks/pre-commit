#!/bin/sh
# pre-commit hook to scan for secrets using gitleaks

# Fail closed if gitleaks is not available
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "ERROR: gitleaks is not installed or not in PATH."
    echo "Secret scanning is required. Please install gitleaks."
    exit 1
fi

# Run gitleaks on staged changes, redacting output to prevent logging secrets
# Using --verbose to show which files failed, but --redact will hide the secret values.
gitleaks git --staged --verbose --redact
exit_code=$?

if [ $exit_code -ne 0 ]; then
    echo "ERROR: gitleaks detected potential secrets in staged files."
    echo "Commit rejected."
    exit $exit_code
fi

exit 0
